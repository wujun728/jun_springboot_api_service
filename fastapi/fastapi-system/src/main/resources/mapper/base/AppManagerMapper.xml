<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zy.base.mapper.AppManagerMapper">

    <resultMap type="AppManager" id="AppManagerResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="prefix"    column="prefix"    />
        <result property="dbConfigId"    column="db_config_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectAppManagerVo">
        select id, name, prefix, db_config_id, create_by, create_time, update_by, update_time, remark from app_manager
    </sql>

    <select id="selectAppManagerList" parameterType="AppManager" resultMap="AppManagerResult">
        <include refid="selectAppManagerVo"/>
        <where>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="prefix != null  and prefix != ''"> and prefix like concat('%', #{prefix}, '%')</if>
            <if test="dbConfigId != null "> and db_config_id = #{dbConfigId}</if>
        </where>
    </select>

    <select id="selectAppManagerListByNamePrefix" parameterType="AppManager" resultMap="AppManagerResult">
        <include refid="selectAppManagerVo"/>
        <where>
            <if test="name != null  and name != ''"> and name = #{name}</if>
            <if test="prefix != null  and prefix != ''"> and prefix = #{prefix}</if>
        </where>
    </select>

    <select id="selectAppManagerById" parameterType="Long" resultMap="AppManagerResult">
        <include refid="selectAppManagerVo"/>
        where id = #{id}
    </select>

    <insert id="insertAppManager" parameterType="AppManager" useGeneratedKeys="true" keyProperty="id">
        insert into app_manager
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="prefix != null and prefix != ''">prefix,</if>
            <if test="dbConfigId != null">db_config_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="prefix != null and prefix != ''">#{prefix},</if>
            <if test="dbConfigId != null">#{dbConfigId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateAppManager" parameterType="AppManager">
        update app_manager
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="prefix != null and prefix != ''">prefix = #{prefix},</if>
            <if test="dbConfigId != null">db_config_id = #{dbConfigId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAppManagerById" parameterType="Long">
        delete from app_manager where id = #{id}
    </delete>

    <delete id="deleteAppManagerByIds" parameterType="String">
        delete from app_manager where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="findAll" resultMap="AppManagerResult">
        <include refid="selectAppManagerVo"/>
    </select>

</mapper>
