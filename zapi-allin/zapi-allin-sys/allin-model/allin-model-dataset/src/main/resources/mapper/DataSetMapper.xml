<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zapi.dataset.mapper.DataSetMapper">

    <resultMap id="BaseResultMap" type="com.zapi.dataset.model.entity.DataSet">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="description" property="description" />
        <result column="source_table" property="sourceTable" />
        <result column="data_source_id" property="dataSourceId" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="deleted" property="deleted" />
    </resultMap>

    <select id="selectPage" resultMap="BaseResultMap">
        SELECT * FROM ds_dataset
        WHERE deleted = 0
        <if test="name != null and name != ''">
            AND name LIKE CONCAT('%', #{name}, '%')
        </if>
        ORDER BY id DESC
    </select>

</mapper>