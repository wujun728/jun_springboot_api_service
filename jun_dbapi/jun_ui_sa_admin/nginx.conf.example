# DBApi Nginx 配置示例
# 将前端静态文件和后端 API 通过 Nginx 统一入口访问
#
# 使用方法:
#   1. 将 jun_ui_sa_admin 目录复制到 Nginx 可访问路径
#   2. 启动后端服务 (端口 8520)
#   3. 修改下面的路径配置
#   4. 重新加载 Nginx: nginx -s reload

server {
    listen       80;
    server_name  localhost;

    # 前端静态文件
    location / {
        root   /path/to/jun_ui_sa_admin;
        index  index.html login.html;
        try_files $uri $uri/ /index.html;
    }

    # 后端 API 反向代理
    # 匹配所有后端控制器路径
    location ~ ^/(user|apiConfig|datasource|group|token|firewall|table|api)/ {
        proxy_pass http://127.0.0.1:8520;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 支持大文件上传
        client_max_body_size 50m;

        # 超时设置
        proxy_connect_timeout 60s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # 静态资源缓存
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        root /path/to/jun_ui_sa_admin;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # 错误页面
    error_page 500 502 503 504 /sa-view/error-page/500.html;
    error_page 404 /sa-view/error-page/404.html;
    error_page 403 /sa-view/error-page/403.html;
}
